+
+fn cmd_help() {
+    vga::print_str("Commands:\n", Color::Cyan);
+    vga::print_str("  [Base]\n", Color::Cyan);
+    vga::print_str("> help     - Show this manual\n", Color::LightGray);
+    vga::print_str("> clear    - Clear screen\n", Color::LightGray);
+    vga::print_str("> echo [t] - Print text to console\n", Color::LightGray);
+    vga::print_str("  [Memory]\n", Color::Cyan);
+    vga::print_str("> mem      - Show physical memory manager stats\n", Color::LightGray);
+    vga::print_str("> alloc    - Allocate one 4 KiB physical frame\n", Color::LightGray);
+    vga::print_str("> free     - Free last allocated frame\n", Color::LightGray);
+    vga::print_str("  [Power]\n", Color::Cyan);
+    vga::print_str("> reboot   - Reboot PC\n", Color::LightGray);
+    vga::print_str("> shutdown - Power off PC\n", Color::LightGray);
+}
+
+fn cmd_mem() {
+    let stats = memory::stats();
+
+    vga::print_str("Physical Memory Manager:\n", Color::Cyan);
+    vga::print_str("  initialized: ", Color::LightGray);
+    if memory::is_initialized() {
+        vga::print_str("yes\n", Color::LightGreen);
+    } else {
+        vga::print_str("no\n", Color::Red);
+    }
+
+    vga::print_str("  total memory: ", Color::LightGray);
+    print_usize(stats.total_memory_kib, Color::White);
+    vga::print_str(" KiB\n", Color::LightGray);
+
+    vga::print_str("  free memory:  ", Color::LightGray);
+    print_usize(stats.free_memory_kib, Color::White);
+    vga::print_str(" KiB\n", Color::LightGray);
+
+    vga::print_str("  total frames: ", Color::LightGray);
+    print_usize(stats.total_frames, Color::White);
+    vga::print_char(b'\n', Color::LightGray);
+
+    vga::print_str("  free frames:  ", Color::LightGray);
+    print_usize(stats.free_frames, Color::White);
+    vga::print_char(b'\n', Color::LightGray);
+
+    vga::print_str("  used frames:  ", Color::LightGray);
+    print_usize(stats.used_frames, Color::White);
+    vga::print_char(b'\n', Color::LightGray);
+}
+
+fn cmd_alloc() {
+    match memory::alloc_frame() {
+        Some(frame) => unsafe {
+            LAST_FRAME = Some(frame);
+            vga::print_str("Allocated frame: 0x", Color::LightGreen);
+            print_hex(frame.addr, Color::White);
+            vga::print_char(b'\n', Color::LightGray);
+        },
+        None => vga::print_str("[!] Out of physical frames.\n", Color::Red),
+    }
+}
+
+fn cmd_free() {
+    unsafe {
+        match LAST_FRAME {
+            Some(frame) => {
+                memory::free_frame(frame);
+                LAST_FRAME = None;
+                vga::print_str("Freed frame: 0x", Color::LightGreen);
+                print_hex(frame.addr, Color::White);
+                vga::print_char(b'\n', Color::LightGray);
+            }
+            None => vga::print_str("[!] No saved frame to free. Use 'alloc' first.\n", Color::Red),
+        }
+    }
+}
+
+fn cmd_reboot() {
+    vga::print_str("Rebooting...\n", Color::Red);
+    unsafe {
+        let mut timeout: u32 = 0;
+        loop {
+            let status: u8;
+            asm!("in al, 0x64", out("al") status);
+
+            if status == 0xFF || timeout > 100_000 {
+                break;
+            }
+
+            if status & 0x02 == 0 {
+                asm!("out 0x64, al", in("al") 0xFEu8);
+                break;
+            }
+
+            timeout += 1;
+        }
+
+        vga::print_str("PS/2 reboot failed...", Color::Red);
+        loop { asm!("hlt"); }
+    }
+}
+
+fn cmd_shutdown() {
+    vga::print_str("Shutting down...\n", Color::Red);
+    unsafe {
+        asm!("out dx, ax", in("dx") 0x604u16, in("ax") 0x2000u16);
+        vga::print_str("i440FX shutdown failed...", Color::Red);
+        loop { asm!("hlt"); }
+    }
+}
+
+fn print_usize(mut value: usize, color: Color) {
+    let mut buffer: [u8; 20] = [0; 20];
+    let mut pos: usize = buffer.len();
+
+    if value == 0 {
+        vga::print_char(b'0', color);
+        return;
+    }
+
+    while value != 0 {
+        pos -= 1;
+        buffer[pos] = b'0' + (value % 10) as u8;
+        value /= 10;
+    }
+
+    while pos < buffer.len() {
+        vga::print_char(buffer[pos], color);
+        pos += 1;
+    }
+}
+
+fn print_hex(value: usize, color: Color) {
+    let mut shift: usize = (core::mem::size_of::<usize>() * 8) - 4;
+    let mut started = false;
+
+    loop {
+        let digit: u8 = ((value >> shift) & 0xF) as u8;
+        if digit != 0 || started || shift == 0 {
+            started = true;
+            let ch = if digit < 10 { b'0' + digit } else { b'A' + (digit - 10) };
+            vga::print_char(ch, color);
+        }
+
+        if shift == 0 { break; }
+        shift -= 4;
+    }
+}
